# Hostname der Zammad-Instanz, ohne https://
ZAMMAD_URL=support.example.com

# Docker-Netz, in dem Zammad laeuft (siehe `docker network ls`)
ZAMMAD_NETWORK=frontend-net

# Zammad-API-Token mit der Berechtigung admin.channel_email
ZAMMAD_SPAMFILTER_API_TOKEN=changeme

# ID der Gruppe zz_Spam und des Status "closed" (Ermittlung siehe README)
ZAMMAD_SPAMFILTER_GROUP_ID=
ZAMMAD_SPAMFILTER_STATE_ID=4

# Optional: Bearer-Token aus der Webhook-Konfiguration in Zammad.
# Leer lassen = keine Pruefung.
ZAMMAD_SPAMFILTER_WEBHOOK_TOKEN=
